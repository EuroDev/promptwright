# Copy to .env.local for development, and set the same values in Vercel's
# project settings for production. Never commit .env.local.

# The canonical origin. Used for Open Graph URLs, robots.txt and the sitemap.
NEXT_PUBLIC_SITE_URL=https://promptwright.cloud

# --- Waitlist backend: set ONE of the two below ---

# Option A (recommended): Loops. Create a key at https://app.loops.so → Settings → API.
LOOPS_API_KEY=

# Option B: any endpoint that accepts a JSON POST — Zapier, Make, a Google Sheet
# webhook, or your own handler. Ignored when LOOPS_API_KEY is set.
WAITLIST_WEBHOOK_URL=
